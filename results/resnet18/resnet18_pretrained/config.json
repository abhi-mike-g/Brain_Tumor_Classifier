{
  "seed": 42,
  "classes": [
    "glioma",
    "meningioma",
    "notumor",
    "pituitary"
  ],
  "data": {
    "raw_dir": "data/raw",
    "inventory_csv": "splits/inventory.csv",
    "split_csv": "splits/split.csv",
    "exclude_name_regex": "aug"
  },
  "image": {
    "size": 224,
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "split": {
    "ratios": {
      "train": 0.7,
      "val": 0.15,
      "test": 0.15
    },
    "dup_hamming_threshold": 2
  },
  "augment": {
    "rotation_deg": 10,
    "hflip_p": 0.5,
    "crop_scale_min": 0.85
  },
  "run_name": "resnet18_pretrained",
  "out_dir": "results/resnet18",
  "pretrained": true,
  "dropout": 0.2,
  "epochs": 20,
  "batch_size": 32,
  "lr": 0.0003,
  "weight_decay": 0.0001,
  "patience": 5,
  "num_workers": 2
}